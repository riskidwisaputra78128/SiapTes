{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/generate.js": {
      "maxDuration": 60
    },
    "api/grade.js": {
      "maxDuration": 30
    },
    "api/materials.js": {
      "maxDuration": 30
    },
    "api/news.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/generate",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/generate?type=samarkan",
      "schedule": "30 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/midtrans-webhook",
      "destination": "/api/auth?hook=midtrans"
    },
    {
      "source": "/api/xendit-webhook",
      "destination": "/api/auth?hook=xendit"
    }
  ]
}